# Copy this file to .env.testing. Use a dedicated TESTING Supabase project.
# Never put production database credentials or production service keys here.
DATABASE_URL=postgresql://postgres:ENCODED_TEST_PASSWORD@TEST_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://TEST_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_testing_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_testing_server_only_service_key
APP_URL=http://localhost:3000
ALLOW_PUBLIC_SIGNUP=false
COOKIE_SECURE=false
# Set true when the testing database presents a publicly trusted certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
PORT=3000
