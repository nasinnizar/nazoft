# Reserved password characters must be percent-encoded: @ is %40 and # is %23.
DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@PROJECT.supabase.co:5432/postgres
# Set this when the direct Supabase database hostname is IPv6-only. The server
# will keep the same password and use the IPv4-compatible session pooler.
SUPABASE_DB_POOLER_REGION=ap-south-1
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Required only for server-side team invitations. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Production URL used in Supabase email links, for example https://nazoft.vercel.app
APP_URL=http://localhost:3000
# Keep false for an invitation-only CRM.
ALLOW_PUBLIC_SIGNUP=false
PORT=3000
# Set true for Vercel production. Keep false only for localhost.
COOKIE_SECURE=false
# Keep certificate verification enabled on Vercel/production. Disable only for
# a trusted local database that uses a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
